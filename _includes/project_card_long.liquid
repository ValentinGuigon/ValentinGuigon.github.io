{% assign project_slug = project.title | slugify %}
{% assign project_image = project.image | default: project.img %}
{% assign project_image_alt = project.image_alt | default: '' %}
{% assign project_image_dialog_id = 'project-image-dialog-' | append: project_slug %}
{% assign fallback_seed = project_slug.size | plus: project.title.size | plus: project.section.size | plus: project.sort_year | plus: project.sort_rank %}
{% assign fallback_variant = fallback_seed | modulo: 6 %}
<article class="card project-card project-card--{{ project_slug }}{% if project_image %} project-card--has-image{% endif %} mt-4 mb-4 hoverable">
  <div class="project-card__art{% if project_image %} project-card__art--image{% endif %}"{% unless project_image %} aria-hidden="true"{% endunless %}>
    {% if project_image %}
      <div class="project-card__art-frame">
        <button
          class="project-card__art-button"
          type="button"
          aria-label="View full image for {{ project.title | escape }}"
          onclick="document.getElementById('{{ project_image_dialog_id }}').showModal()"
        >
          <img
            class="project-card__art-image"
            src="{{ project_image | relative_url }}"
            alt="{{ project_image_alt }}"
            loading="lazy"
            decoding="async"
          >
        </button>
      </div>
      <dialog
        id="{{ project_image_dialog_id }}"
        class="project-image-dialog"
        aria-label="Full image for {{ project.title | escape }}"
        onclick="if (event.target === this) this.close()"
      >
        <button
          class="project-image-dialog__close"
          type="button"
          aria-label="Close full image"
          onclick="this.closest('dialog').close()"
        >
          &times;
        </button>
        <img
          class="project-image-dialog__image"
          src="{{ project_image | relative_url }}"
          alt="{{ project_image_alt }}"
          decoding="async"
          onclick="this.closest('dialog').close()"
        >
      </dialog>
    {% else %}
      {% case fallback_variant %}
      {% when 0 %}
        <svg viewBox="0 0 520 320" role="presentation" focusable="false">
          <g fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M162 70C225 30 321 37 381 83C429 119 442 183 419 230C397 274 339 297 284 287C215 274 169 209 177 150C182 113 208 82 245 65" stroke="var(--project-art-line)" stroke-width="1.4" />
            <path d="M138 105C187 68 267 57 334 82C394 104 434 154 434 205C434 244 407 274 361 286" stroke="var(--project-art-line-strong)" stroke-width="1.2" />
            <path d="M217 44C282 27 358 41 413 90" stroke="var(--project-art-line)" stroke-width="0.95" />
            <path d="M306 54V128M334 54V128M362 54V128M390 54V128M306 54H390M306 79H390M306 104H390M306 128H390" stroke="var(--project-art-grid)" stroke-width="0.9" />
          </g>
          <g fill="var(--project-art-dot)">
            <circle cx="257" cy="133" r="4.2" />
            <circle cx="288" cy="117" r="3.6" />
            <circle cx="319" cy="142" r="3.9" />
            <circle cx="296" cy="163" r="3.1" />
            <circle cx="269" cy="176" r="2.8" />
            <circle cx="335" cy="171" r="2.6" />
            <circle cx="238" cy="156" r="2.5" />
          </g>
        </svg>
      {% when 1 %}
        <svg viewBox="0 0 520 320" role="presentation" focusable="false">
          <g fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M176 250C219 218 244 205 277 181C311 156 333 127 365 96C380 81 397 70 420 63" stroke="var(--project-art-line-strong)" stroke-width="1.7" />
            <path d="M152 232C205 195 254 173 300 139C334 114 367 90 406 74" stroke="var(--project-art-line)" stroke-width="1.05" />
            <path d="M270 94V184M300 94V184M330 94V184M360 94V184M390 94V184M270 94H390M270 124H390M270 154H390M270 184H390" stroke="var(--project-art-grid)" stroke-width="0.9" />
          </g>
          <g fill="var(--project-art-dot)">
            <circle cx="213" cy="221" r="4.3" />
            <circle cx="258" cy="193" r="3.8" />
            <circle cx="304" cy="157" r="4.1" />
            <circle cx="352" cy="109" r="3.6" />
            <circle cx="404" cy="70" r="4.2" />
            <circle cx="342" cy="199" r="2.8" />
            <circle cx="377" cy="173" r="2.5" />
            <circle cx="286" cy="219" r="2.7" />
          </g>
        </svg>
      {% when 2 %}
        <svg viewBox="0 0 520 320" role="presentation" focusable="false">
          <g fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M152 198C206 165 241 157 285 140C337 120 379 96 432 69" stroke="var(--project-art-line-strong)" stroke-width="1.35" />
            <path d="M181 84C236 62 299 60 350 80C397 99 429 136 437 183C444 225 423 262 381 283" stroke="var(--project-art-line)" stroke-width="1.1" />
            <path d="M236 110C251 139 280 160 314 167C350 174 383 168 412 150" stroke="var(--project-art-line)" stroke-width="0.95" />
            <path d="M284 58V150M313 58V150M342 58V150M371 58V150M284 58H371M284 88H371M284 118H371M284 150H371" stroke="var(--project-art-grid)" stroke-width="0.9" />
          </g>
          <g fill="var(--project-art-dot)">
            <circle cx="229" cy="173" r="3.2" />
            <circle cx="270" cy="153" r="2.8" />
            <circle cx="315" cy="138" r="3.5" />
            <circle cx="359" cy="116" r="3.1" />
            <circle cx="404" cy="88" r="3.7" />
            <circle cx="390" cy="191" r="2.7" />
          </g>
        </svg>
      {% when 3 %}
        <svg viewBox="0 0 520 320" role="presentation" focusable="false">
          <g fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M164 244C198 206 238 171 284 137C322 108 366 81 424 56" stroke="var(--project-art-line)" stroke-width="1.2" />
            <path d="M189 224C233 219 269 206 304 180C336 157 363 124 389 88" stroke="var(--project-art-line-strong)" stroke-width="1.35" />
            <path d="M187 94C215 74 252 66 290 69C333 73 373 99 395 134C416 166 420 205 408 240" stroke="var(--project-art-line)" stroke-width="1" />
            <path d="M255 72L388 72M255 103L388 103M255 134L388 134M255 165L388 165" stroke="var(--project-art-grid)" stroke-width="0.82" />
          </g>
          <g fill="var(--project-art-dot)">
            <circle cx="232" cy="199" r="3.8" />
            <circle cx="269" cy="174" r="3.1" />
            <circle cx="304" cy="149" r="3.4" />
            <circle cx="341" cy="120" r="3.2" />
            <circle cx="380" cy="88" r="3.6" />
            <circle cx="361" cy="206" r="2.5" />
          </g>
        </svg>
      {% when 4 %}
        <svg viewBox="0 0 520 320" role="presentation" focusable="false">
          <g fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M171 126C215 83 282 60 350 67C404 72 447 105 463 153C477 195 462 243 421 274" stroke="var(--project-art-line-strong)" stroke-width="1.25" />
            <path d="M158 206C203 182 245 164 288 141C331 119 375 92 430 73" stroke="var(--project-art-line)" stroke-width="1.08" />
            <path d="M209 237C248 220 288 213 326 215C365 217 398 229 429 252" stroke="var(--project-art-line)" stroke-width="0.92" />
            <path d="M300 54V136M329 54V136M358 54V136M387 54V136M300 54H387M300 81H387M300 108H387M300 136H387" stroke="var(--project-art-grid)" stroke-width="0.88" />
          </g>
          <g fill="var(--project-art-dot)">
            <circle cx="216" cy="176" r="3.1" />
            <circle cx="252" cy="159" r="3.5" />
            <circle cx="290" cy="141" r="3.2" />
            <circle cx="333" cy="121" r="3.7" />
            <circle cx="376" cy="100" r="3.1" />
            <circle cx="419" cy="80" r="3.9" />
            <circle cx="351" cy="210" r="2.4" />
          </g>
        </svg>
      {% else %}
        <svg viewBox="0 0 520 320" role="presentation" focusable="false">
          <g fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M151 230C198 192 246 165 294 140C340 116 386 93 439 78" stroke="var(--project-art-line)" stroke-width="1.15" />
            <path d="M180 116C215 84 266 64 321 68C371 72 417 100 442 141C467 181 467 235 440 275" stroke="var(--project-art-line-strong)" stroke-width="1.18" />
            <path d="M241 219C276 202 313 194 348 197C382 200 412 212 438 234" stroke="var(--project-art-line)" stroke-width="0.9" />
            <path d="M287 68V158M318 68V158M349 68V158M380 68V158M287 68H380M287 98H380M287 128H380M287 158H380" stroke="var(--project-art-grid)" stroke-width="0.86" />
          </g>
          <g fill="var(--project-art-dot)">
            <circle cx="229" cy="195" r="3.4" />
            <circle cx="267" cy="170" r="3.1" />
            <circle cx="309" cy="149" r="3.5" />
            <circle cx="352" cy="126" r="2.9" />
            <circle cx="391" cy="103" r="2.7" />
            <circle cx="363" cy="211" r="2.5" />
          </g>
        </svg>
      {% endcase %}
    {% endif %}
  </div>

  <div class="card-body project-card__body">
    <div class="project-card__content">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start">
        <div class="project-card__heading">
          <h2 class="project-card__title mb-0">{{ project.title }}</h2>
          {% assign meta_parts = '' | split: '' %}
          {% if project.date_range %}
            {% assign meta_parts = meta_parts | push: project.date_range %}
          {% endif %}
          {% if project.context %}
            {% assign meta_parts = meta_parts | push: project.context %}
          {% endif %}
          {% if meta_parts.size > 0 %}
            <p class="project-card__meta mb-0">{{ meta_parts | join: ' | ' }}</p>
          {% endif %}
        </div>
      </div>

      {% if project.tags and project.tags.size > 0 %}
        <ul class="project-card__tags" aria-label="Project tags">
          {% for tag in project.tags %}
            <li>{{ tag }}</li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if project.description_paragraphs and project.description_paragraphs.size > 0 %}
        {% for paragraph in project.description_paragraphs %}
          <div class="project-card__description{% unless forloop.last %} mb-3{% else %} mb-0{% endunless %}">{{ paragraph | markdownify }}</div>
        {% endfor %}
      {% elsif project.description %}
        <div class="project-card__description mb-0">{{ project.description | markdownify }}</div>
      {% endif %}

      {% if project.links and project.links.size > 0 %}
        <div class="project-card__links" aria-label="Project links">
          {% for link in project.links %}
            {% assign link_label = link.label | downcase %}
            {% assign link_url = link.url | downcase %}
            <a class="project-card__link" href="{{ link.url }}">
              <span class="project-card__link-icon" aria-hidden="true">
                {% if link_label contains 'github' or link_url contains 'github.com' %}
                  <i class="fa-brands fa-github"></i>
                {% elsif link_label contains 'poster' or link_url contains '/assets/pdf/posters/' %}
                  <i class="fa-solid fa-image"></i>
                {% elsif link_label contains 'osf' or link_url contains 'osf.io' %}
                  <i class="ai ai-osf"></i>
                {% elsif link_label contains 'paper' or link_url contains '/articles/' or link_url contains 'doi.org' or link_url contains 'nature.com/articles' %}
                  <i class="fa-solid fa-file-lines"></i>
                {% elsif link_label contains 'live page' or link_label contains 'live site' or link_url contains 'github.io' %}
                  <i class="fa-solid fa-globe"></i>
                {% elsif link_label contains 'substack' or link_url contains 'substack.com' %}
                  <i class="fa-solid fa-newspaper"></i>
                {% elsif link_label contains 'pypi' or link_url contains 'pypi.org' %}
                  <i class="fa-brands fa-python"></i>
                {% elsif link_label contains 'read the docs' or link_label contains 'docs' or link_url contains 'readthedocs' %}
                  <i class="fa-solid fa-book-open"></i>
                {% else %}
                  <i class="fa-solid fa-arrow-up-right-from-square"></i>
                {% endif %}
              </span>
              <span class="project-card__link-label">{{ link.label }}</span>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</article>
